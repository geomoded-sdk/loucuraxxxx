#version 450
// LoucuraXXXX GPU - unsharp-mask sharpen compute shader.
// Mirrors filters/builtin/sharpen_filter.cpp: a 3x3 box blur subtracted from
// the original, scaled by strength.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D in_image;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D out_image;
layout(push_constant) uniform PushConstants {
    float strength;
    vec2  image_size;
    vec2  _pad;
} pc;
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.image_size.x) || coord.y >= int(pc.image_size.y)) return;
    vec3 avg = vec3(0.0);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 s = clamp(coord + ivec2(dx, dy), ivec2(0),
                            ivec2(int(pc.image_size.x) - 1, int(pc.image_size.y) - 1));
            avg += imageLoad(in_image, s).rgb;
        }
    }
    avg /= 9.0;
    vec4 src = imageLoad(in_image, coord);
    vec3 sharpened = src.rgb + pc.strength * (src.rgb - avg);
    imageStore(out_image, coord, vec4(clamp(sharpened, 0.0, 1.0), src.a));
}
