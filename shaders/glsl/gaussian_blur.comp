#version 450
// LoucuraXXXX GPU - separable Gaussian blur compute shader.
//
// One pass along a single axis; the host runs it twice (horizontal, then
// vertical) with `axis` selecting the direction. The kernel is generated on the
// fly from sigma, matching build_kernel() in blur_filter.cpp.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D in_image;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D out_image;

layout(push_constant) uniform PushConstants {
    float sigma;
    float intensity;
    vec2  image_size;
    int   axis;      // 0 = horizontal, 1 = vertical
    int   radius;
    int   _pad0;
    int   _pad1;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.image_size.x) || coord.y >= int(pc.image_size.y)) return;

    int radius = pc.radius;
    float denom = 2.0 * pc.sigma * pc.sigma;
    vec4 accum = vec4(0.0);
    float weight_sum = 0.0;

    for (int k = -radius; k <= radius; ++k) {
        ivec2 sample_coord = coord;
        if (pc.axis == 0) sample_coord.x = clamp(coord.x + k, 0, int(pc.image_size.x) - 1);
        else              sample_coord.y = clamp(coord.y + k, 0, int(pc.image_size.y) - 1);

        float w = exp(-float(k * k) / denom);
        accum += imageLoad(in_image, sample_coord) * w;
        weight_sum += w;
    }

    vec4 blurred = accum / weight_sum;
    vec4 src = imageLoad(in_image, coord);
    imageStore(out_image, coord, mix(src, blurred, pc.intensity));
}
