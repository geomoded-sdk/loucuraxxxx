#version 450
// LoucuraXXXX GPU - vignette compute shader.
// Mirrors filters/builtin/vignette_filter.cpp with a smoothstep falloff.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D in_image;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D out_image;
layout(push_constant) uniform PushConstants {
    float inner;
    float outer;
    float intensity;
    float _pad0;
    vec2  image_size;
    vec2  _pad1;
} pc;
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.image_size.x) || coord.y >= int(pc.image_size.y)) return;
    vec2 center = pc.image_size * 0.5;
    float max_radius = length(center);
    float radius = length(vec2(coord) - center) / max_radius;
    float t = clamp((radius - pc.inner) / max(pc.outer - pc.inner, 1e-3), 0.0, 1.0);
    float falloff = t * t * (3.0 - 2.0 * t);
    float factor = 1.0 - falloff * pc.intensity;
    vec4 src = imageLoad(in_image, coord);
    imageStore(out_image, coord, vec4(src.rgb * factor, src.a));
}
